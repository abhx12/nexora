# =================================================================================================
# SmartSilk Standalone Server Engine Configuration
# =================================================================================================
# Copy to .env (or run ./start-server.sh / start-server.bat which creates it automatically).
# Every setting can be customized for your local server or shop deployment.

# =================================================================================================
# 1. CORE SERVER & DATABASE
# =================================================================================================
# Port to expose the SmartSilk backend API service on the host
SERVER_PORT=8088

# Optional custom backend image (defaults to official GHCR image)
SERVER_IMAGE=ghcr.io/nithiishsd/nexora-backend:latest

# PostgreSQL 17 Database Configuration
DB_NAME=smartsilk_ledger_db
DB_USER=postgres
DB_PASSWORD=smartsilk_server_secure_password

# JVM memory and error handling (uses up to 75% container memory)
JAVA_OPTS=-XX:MaxRAMPercentage=75 -XX:+ExitOnOutOfMemoryError

# =================================================================================================
# 2. SECURITY, AUTHENTICATION & INITIAL SETUP
# =================================================================================================
# Master HS256 JWT Signing Key (at least 32 characters; generated on first start)
JWT_SECRET=smartsilk-server-production-master-jwt-secret-key-32chars

# First OWNER Account (Created automatically on initial startup if users table is empty)
BOOTSTRAP_OWNER_USERNAME=owner
BOOTSTRAP_OWNER_PASSWORD=DevOwner#2026pass

# Session & Token Lifetimes (Spring Durations)
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Account Lockout & Brute-Force Protection
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT=15m

# Rate Limiting (Protection against request flooding)
RATE_LIMIT_ENABLED=true

# =================================================================================================
# 3. DOCUMENTS & OBJECT STORAGE
# =================================================================================================
# Storage mode: 'local' (filesystem volume) or 's3' (AWS / MinIO / Cloudflare R2)
STORAGE_PROVIDER=local
DOCUMENTS_DIR=/var/lib/nexora/documents

# Optional S3 / MinIO Configuration (Active only when STORAGE_PROVIDER=s3)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET_NAME=smartsilk-documents
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# =================================================================================================
# 4. BUSINESS & THIRD-PARTY INTEGRATIONS (PRE-CONFIGURED SANDBOX DEFAULTS)
# =================================================================================================
# --- WhatsApp Business API notifications (FR-NTF-08) ---
WHATSAPP_API_ENABLED=false
WHATSAPP_API_URL=https://graph.facebook.com/v19.0
WHATSAPP_PHONE_NUMBER_ID=109283746501928
WHATSAPP_ACCESS_TOKEN=EAAG_sandbox_token_replace_with_meta_business_token

# --- GST e-Invoicing & E-Way Bill Portal (FR-DOC-06) ---
GST_EINVOICE_ENABLED=false
GST_API_BASE_URL=https://api-sandbox.einvoice.nic.in
GST_CLIENT_ID=sandbox_client_nexora
GST_CLIENT_SECRET=sandbox_secret_nexora_2026
GST_AUTH_TOKEN=sandbox_auth_token_mock
GSTIN=33AAAAA0000A1Z5

# --- Banking & Automated Statement Feeds (FR-FIN-20) ---
BANK_INTEGRATION_ENABLED=false
BANK_API_BASE_URL=http://localhost:8089/api/v1/bank-feed
BANK_CLIENT_ID=nexora_bank_sandbox_client
BANK_CLIENT_SECRET=nexora_bank_sandbox_secret

# --- AI Document OCR & Intelligent Bill Extraction ---
AI_OCR_PROVIDER=gemini
GEMINI_API_KEY=AIzaSy_demo_replace_with_your_google_ai_gemini_api_key

# =================================================================================================
# 5. BACKUPS & HEALTH ALERTS (OPTIONAL)
# =================================================================================================
# age recipient public key for encrypted database backups
AGE_PUBLIC_KEY=age1ql3z7hjy54pw3hyww5ayyfg7zqgvc7w3j2elw8zmrj2kg5wh98qqvq8msr
# rclone remote target for cloud backup synchronization
RCLONE_REMOTE=local-backups:./data/backups
# Dead-man's-switch ping URL pinged on backup success
HEALTHCHECK_PING_URL=http://localhost:8088/actuator/health
# Webhook URL for alert notifications (e.g. ntfy.sh, Slack, or Discord)
ALERT_WEBHOOK_URL=http://localhost:8088/actuator/info
